# Consumer token profiles for the WHI GitHub App token minter (WAL-68).
#
# Each profile maps a consumer to the MINIMUM repos + permissions it needs.
# Sourced by mint-installation-token.sh --profile <name>. Profile name <name>
# is upper-cased and '-' -> '_' to form the variable names below.
#
# Format:
#   PROFILE_<NAME>_REPOS="repo1,repo2"            # repo names only (owner is the install owner)
#   PROFILE_<NAME>_PERMS="contents=read,metadata=read"
#
# Rationale per profile: docs/2026-06-30-github-app-token-profiles.md
# Extend this list as consumers migrate off the shared admin PAT.

# config-service (WAL-60): reads template/config files from private product repos.
# Needs read-only Contents across the product repos — NOT Administration.
PROFILE_CONFIG_SERVICE_REPOS="NovaVM,FamiForge,NESBasic,Novus,vice-mcp,vice-macos,RetroDraw"
PROFILE_CONFIG_SERVICE_PERMS="contents=read,metadata=read"

# product-ci (Keel deploy/release bot): cog version bumps, tag + release pushes,
# static-site/app deploys. Needs Contents write on the product repos. No admin.
PROFILE_PRODUCT_CI_REPOS="NovaVM,FamiForge,NESBasic,Novus,vice-mcp,vice-macos,RetroDraw"
PROFILE_PRODUCT_CI_PERMS="contents=write,metadata=read"

# infra-protection (Atlas, WAL-65 branch-protection maintenance ONLY): the only
# profile that carries Administration, scoped to the single infrastructure repo.
PROFILE_INFRA_PROTECTION_REPOS="infrastructure"
PROFILE_INFRA_PROTECTION_PERMS="administration=write,contents=read,metadata=read"

# swiftpm-read (WAL-143): resolves the PRIVATE PixelCanvasKit SwiftPM package for
# the build-macos-app gate (FamiForge, RetroDraw). Read-only, single repo — the
# minimum for xcodebuild/SwiftPM to clone the package non-interactively. Lets the
# gate move off the shared-PAT contents:read it used for package resolution (WAL-142).
# REQUIRES (Barry): barryw/PixelCanvasKit added to the WHI GitHub App installation
# selection, else `mint --profile swiftpm-read` returns HTTP 422 (repo not in install).
PROFILE_SWIFTPM_READ_REPOS="PixelCanvasKit"
PROFILE_SWIFTPM_READ_PERMS="contents=read,metadata=read"
