when:
  - event: [push, pull_request]

labels:
  platform: linux/amd64

clone:
  git:
    image: woodpeckerci/plugin-git
    settings:
      tags: true
      depth: 0

steps:
  - name: validate-commits
    image: ghcr.io/cocogitto/cog:6.2.0
    commands:
      - git fetch --tags origin 2>/dev/null || true
      - cog check --from-latest-tag 2>/dev/null || cog check 2>/dev/null || echo "Commit validation skipped"
    when:
      - event: push

  - name: lint
    image: golang:{{or .go_version "1.25"}}
    commands:
      - go vet ./...

  - name: test
    image: golang:{{or .go_version "1.25"}}
    commands:
      - go test -v -race -count=1 ./...
    depends_on: [lint]

  - name: release
    image: ghcr.io/barryw/woodpecker-release:latest
    pull: true
    environment:{{if .mint_token}}
      # WAL-142: mint-mode delivers ONLY the short-lived App token — no shared PAT
      # is present, so the plugin cannot silently fall back to it (entrypoint.sh).
      # Once every consumer sets mint_token, the non-mint PAT branch and the shared
      # github_token secret can both be removed (WAL-71 revoke).
      GH_APP_ID:
        from_secret: gh_app_id
      GH_APP_INSTALLATION_ID:
        from_secret: gh_app_installation_id
      GH_APP_PRIVATE_KEY:
        from_secret: gh_app_private_key{{else}}
      PLUGIN_GITHUB_TOKEN:
        from_secret: github_token{{end}}
      PLUGIN_GIT_EMAIL: ci@barrywalker.io
      PLUGIN_MODE: release-tag
    when:
      - event: push
        branch: main
    depends_on: [validate-commits, test]
