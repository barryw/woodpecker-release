# release-static-site — Walker Heavy Industries house template.
#
# kaniko build -> GHCR -> kubectl apply/set-image/rollout -> Cloudflare purge.
# This is the deploy pattern Novus (novuslang.com) and RetroDraw (miggydraw.com)
# already share, parameterized so every product/marketing site and the house
# hub deploy identically. Sites are NOT versioned releases — they ship on
# website/** changes to main and are tagged by pipeline number.
#
# Required secrets: ghcr_username, ghcr_token, cloudflare_api_token, and the
#                   zone secret named by .cloudflare_zone (default
#                   cloudflare_zone_id).
# Parameters (data:) — see README "release-static-site".

when:
  - event: push
    branch: main
    path:
      include:
        - website/**
        - deploy/**

labels:
  platform: linux/amd64

steps:
  - name: build-push
    image: gcr.io/kaniko-project/executor:debug
    environment:
      GHCR_USERNAME:
        from_secret: ghcr_username
      GHCR_TOKEN:
        from_secret: ghcr_token
    commands:
      - mkdir -p /kaniko/.docker
      - echo "{\"auths\":{\"ghcr.io\":{\"username\":\"$GHCR_USERNAME\",\"password\":\"$GHCR_TOKEN\"}}}" > /kaniko/.docker/config.json
      - /kaniko/executor --context=$CI_WORKSPACE/{{or .website_context "website"}} --dockerfile=$CI_WORKSPACE/{{or .dockerfile "website/Dockerfile"}} --destination=ghcr.io/barryw/{{or .image_name (printf "%s-website" .site)}}:build-$CI_PIPELINE_NUMBER --destination=ghcr.io/barryw/{{or .image_name (printf "%s-website" .site)}}:latest

  - name: deploy
    image: bitnami/kubectl:latest
    commands:
      - kubectl get namespace {{or .k8s_namespace .site}} || kubectl create namespace {{or .k8s_namespace .site}}
      - kubectl get secret ghcr-secret -n {{or .k8s_namespace .site}} || kubectl get secret ghcr-secret -n default -o json | sed 's/"namespace":"default"/"namespace":"{{or .k8s_namespace .site}}"/' | kubectl apply -f -
      # Resilience (WAL-104 / WAL-124): a deploy must never take the live site down.
      # Server-side apply (SSA) replaces client-side 3-way strategic merge. SSA
      # does a structured field-manager merge, which STRUCTURALLY eliminates the
      # duplicate-container-port failure class that once wedged novuslang.com
      # (a strategic-merge artifact — client-side merge could not reconcile the
      # duplicated port and left the Deployment unpatchable). --force-conflicts
      # takes ownership of fields still held by the old client-side-apply manager
      # on the first SSA of each object; harmless and idempotent thereafter.
      # NOTE: SSA PATCHes every rendered object. The namespace-scoped
      # woodpecker:default CI SA is Forbidden on the cluster-scoped Namespace, so
      # every consumer's CI kustomize build MUST NOT emit namespace.yaml (bootstrap
      # the namespace out-of-band; the `get namespace || create` line above covers
      # first run). See WAL-108 / WAL-66.
      # 1) Validate the rendered manifests against the live cluster BEFORE
      #    mutating anything — a bad manifest fails the pipeline here, safely,
      #    instead of half-applying.
      - kubectl apply -k {{or .deploy_path "deploy/"}} --server-side --force-conflicts --dry-run=server
      - kubectl apply -k {{or .deploy_path "deploy/"}} --server-side --force-conflicts
      - kubectl set image deployment/{{or .deployment_name (printf "%s-website" .site)}} {{or .container_name "website"}}=ghcr.io/barryw/{{or .image_name (printf "%s-website" .site)}}:build-$CI_PIPELINE_NUMBER -n {{or .k8s_namespace .site}}
      # 2) Roll forward; if the new revision never becomes Ready (bad image,
      #    crashloop), auto-revert to the last good ReplicaSet so the site is
      #    never stranded on a broken revision. The rolling update keeps old
      #    pods serving until the new ones pass readiness.
      - |
        if ! kubectl rollout status deployment/{{or .deployment_name (printf "%s-website" .site)}} -n {{or .k8s_namespace .site}} --timeout=120s; then
          echo "Rollout did not become healthy — rolling back to previous revision"
          kubectl rollout undo deployment/{{or .deployment_name (printf "%s-website" .site)}} -n {{or .k8s_namespace .site}}
          kubectl rollout status deployment/{{or .deployment_name (printf "%s-website" .site)}} -n {{or .k8s_namespace .site}} --timeout=120s
          exit 1
        fi
      - kubectl get pods -n {{or .k8s_namespace .site}}
    depends_on:
      - build-push

  - name: purge-cache
    image: curlimages/curl:latest
    environment:
      CLOUDFLARE_ZONE_ID:
        from_secret: {{or .cloudflare_zone "cloudflare_zone_id"}}
      CLOUDFLARE_API_TOKEN:
        from_secret: cloudflare_api_token
    commands:
      - |
        curl -s -X POST "https://api.cloudflare.com/client/v4/zones/$CLOUDFLARE_ZONE_ID/purge_cache" \
          -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
          -H "Content-Type: application/json" \
          --data '{"purge_everything":true}'
      - echo "Cloudflare cache purged for {{.site}}"
    depends_on:
      - deploy
