when:
  - event: push
    branch: main

labels:
  platform: linux/amd64

clone:
  git:
    image: woodpeckerci/plugin-git
    settings:
      tags: true
      depth: 0

depends_on:
  - test
  - commits

steps:
  - name: release
    image: ghcr.io/barryw/woodpecker-release:go
    pull: true
    environment:{{if .gpg_sign}}
      PLUGIN_GPG_KEY:
        from_secret: gpg_private_key
      PLUGIN_GPG_FINGERPRINT:
        from_secret: gpg_fingerprint{{end}}{{if .mint_token}}
      # WAL-142: mint-mode delivers ONLY the short-lived App token — no shared PAT
      # is present, so the plugin cannot silently fall back to it (entrypoint.sh).
      # Once every consumer sets mint_token, the non-mint PAT branch and the shared
      # github_token secret can both be removed (WAL-71 revoke).
      GH_APP_ID:
        from_secret: gh_app_id
      GH_APP_INSTALLATION_ID:
        from_secret: gh_app_installation_id
      GH_APP_PRIVATE_KEY:
        from_secret: gh_app_private_key{{else}}
      PLUGIN_GITHUB_TOKEN:
        from_secret: github_token{{end}}
      PLUGIN_MODE: release-go
      PLUGIN_GIT_EMAIL: ci@barrywalker.io
      PLUGIN_GO_PLATFORMS: {{or .go_platforms "linux/amd64,linux/arm64,darwin/amd64,darwin/arm64,windows/amd64"}}
      PLUGIN_GO_BINARY_NAME: {{or .go_binary_name "app"}}
      PLUGIN_GPG_SIGN: "{{or .gpg_sign "false"}}"
      PLUGIN_TERRAFORM_MANIFEST: "{{or .terraform_manifest "false"}}"
